# Copy this file to .env and fill in your keys. Never share .env.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Airtable token needs scopes data.records:read and schema.bases:read
Airtable_Personal_Access_Token=pat...
Airtable_Base_ID=app...

# --- Optional ---
# Seconds to reuse downloaded data before asking Airtable again
# CACHE_SECONDS=300
# SCHEMA_CACHE_SECONDS=900

# Student table settings used by the reports
# STUDENT_TABLE=Student Profile/Biodata
# STUDENT_NAME_FIELD=Name
# STUDENT_ID_FIELD=Matric_Number
# MISSING_FLAGS_FIELD=Missing Fields

# How many earlier questions the assistant remembers
# MAX_HISTORY_TURNS=20

# Web interface. To let colleagues on your network use it, set
# WEB_HOST=0.0.0.0 AND a password.
# WEB_HOST=127.0.0.1
# WEB_PORT=5000
# APP_PASSWORD=
# SECRET_KEY=any-long-random-text
